# Copy to .env and enter your own API key locally. Never put it in browser code.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
PORT=5500
AUDIO_HELPER_PORT=5502

# Local demo only: false keeps random verification codes.
DEV_SAMPLE_LOGIN=false

# Production / online hosting.
# Keep actual values only in the hosting provider's secret environment variables.
DATABASE_URL=
PUBLIC_ORIGIN=
NODE_ENV=

# Real OTP delivery: configure these in Render (never in frontend/Android).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Local demo only: EMAIL_PROVIDER=development and DEV_SAMPLE_LOGIN=true.


